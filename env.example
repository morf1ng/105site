# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=softstudio_db
POSTGRES_PORT=5432

# Backend Configuration
SECRET_KEY=your-very-secure-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
BACKEND_PORT=8000

# Frontend Configuration
API_BASE_URL=http://localhost:8000
FRONTEND_PORT=3000

# Email (для отправки ссылок на курсы)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

# Ссылки на Telegram-каналы для курсов
TG_LINK_BASIC=https://t.me/your_basic_channel
TG_LINK_SUPPORT_1=https://t.me/your_support_channel_1
TG_LINK_SUPPORT_2=https://t.me/your_support_channel_2

# Для продакшн сервера измените API_BASE_URL на:
# API_BASE_URL=http://your-backend-domain.com:8000
# или если используете reverse proxy:
# API_BASE_URL=https://api.yourdomain.com
